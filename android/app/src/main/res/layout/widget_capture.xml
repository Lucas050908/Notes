<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/capture_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bar" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/capture_field" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center_vertical" android:background="@drawable/widget_field" android:paddingStart="14dp" android:paddingEnd="10dp" android:text="@string/widget_capture_hint" android:fontFamily="@font/caveat_bold" android:textColor="#4B4639" android:textSize="19sp" android:maxLines="1" />
        <ImageView android:id="@+id/capture_daily" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:padding="3dp" android:src="@drawable/widget_journal" android:contentDescription="@string/widget_daily" />
        <ImageView android:id="@+id/capture_new" android:layout_width="40dp" android:layout_height="40dp" android:padding="3dp" android:src="@drawable/widget_add" android:contentDescription="@string/widget_new_note" />
    </LinearLayout>
</FrameLayout>
