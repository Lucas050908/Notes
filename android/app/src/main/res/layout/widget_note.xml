<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/note_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <LinearLayout android:id="@+id/note_card" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_sticky_yellow" android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="20dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/note_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/caveat_bold" android:textColor="#1D1B17" android:textSize="24sp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/note_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:textColor="#4B4639" android:textSize="13sp" android:lineSpacingMultiplier="1.15" android:ellipsize="end" android:maxLines="14" />
        <TextView android:id="@+id/note_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#736C5B" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
